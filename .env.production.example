# Copy to .env.production or put these values in .env — both are loaded.
#
#   cp .env.production.example .env.production

# Required: generate once with `bin/rails secret` and keep the same value
# across restarts so sessions and signed cookies stay valid.
SECRET_KEY_BASE=

# Host port mapped to the app (container listens on 80)
LLM_TESTER_PORT=8080

# Optional
# RAILS_LOG_LEVEL=info
# SIDEKIQ_CONCURRENCY=5
