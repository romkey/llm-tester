# Copy to .env.production or put these values in .env — both are loaded.
#
#   cp .env.production.example .env.production

# Required: generate once with `bin/rails secret` and keep the same value
# across restarts so sessions and signed cookies stay valid.
SECRET_KEY_BASE=

# Host port mapped to the app (container listens on 80)
LLM_TESTER_PORT=8080

# Optional
# RAILS_LOG_LEVEL=info
# SIDEKIQ_CONCURRENCY=5

# --- Database ---------------------------------------------------------------
# The app defaults to SQLite (stored in the llm-tester-prod-storage volume).
# To run on PostgreSQL instead, uncomment these and start the bundled database
# service with: docker compose -f docker-compose.production.yml --profile postgres up -d
#
# DATABASE_ADAPTER=postgresql
# DATABASE_HOST=llm-tester-prod-postgres
# DATABASE_PORT=5432
# DATABASE_NAME=llm_tester_production
# DATABASE_USERNAME=llm_tester
# DATABASE_PASSWORD=change-me
#
# To move existing SQLite data into PostgreSQL, after the app has started once
# (its entrypoint runs db:prepare to create/load the empty schema), run:
#   docker compose -f docker-compose.production.yml run --rm llm-tester-prod-web \
#     bin/rails db:migrate_from_sqlite
# The source defaults to storage/production.sqlite3; override with SQLITE_DATABASE.
