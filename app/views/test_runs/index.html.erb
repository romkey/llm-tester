<h1 class="mb-4">Test Runs</h1>

<%= form_with url: test_runs_path, method: :get, class: "row g-2 mb-4 align-items-end" do %>
  <div class="col-auto">
    <%= label_tag :test_definition_id, "Test", class: "form-label mb-1" %>
    <%= select_tag :test_definition_id,
          options_from_collection_for_select(@test_definitions, :id, :name, params[:test_definition_id]),
          include_blank: "All tests", class: "form-select form-select-sm" %>
  </div>
  <div class="col-auto">
    <%= label_tag :llm_model_id, "Model", class: "form-label mb-1" %>
    <%= select_tag :llm_model_id,
          options_from_collection_for_select(@llm_models, :id, :label_with_server, params[:llm_model_id]),
          include_blank: "All models", class: "form-select form-select-sm" %>
  </div>
  <div class="col-auto">
    <%= label_tag :status, "Result", class: "form-label mb-1" %>
    <%= select_tag :status,
          options_for_select(TestRun::STATUSES.map { |s| [ s.capitalize, s ] }, params[:status]),
          include_blank: "All results", class: "form-select form-select-sm" %>
  </div>
  <div class="col-auto">
    <%= submit_tag "Filter", class: "btn btn-sm btn-primary" %>
    <% if params[:test_definition_id].present? || params[:llm_model_id].present? || params[:status].present? %>
      <%= link_to "Clear", test_runs_path, class: "btn btn-sm btn-outline-secondary" %>
    <% end %>
  </div>
<% end %>

<% if @test_runs.any? %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <th>When</th>
          <th>Test</th>
          <th>Model</th>
          <th>Server</th>
          <th>Result</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @test_runs.each do |run| %>
          <tr>
            <td><%= l(run.created_at, format: :short) %></td>
            <td><%= run.test_definition.name %></td>
            <td><%= run.llm_model.name %></td>
            <td><%= run.server.name %></td>
            <td><%= test_run_badge(run) %></td>
            <td><%= link_to "Details", test_run_path(run), class: "btn btn-sm btn-outline-secondary" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <nav class="mt-3"><%== pagy_nav(@pagy) %></nav>
<% elsif params[:test_definition_id].present? || params[:llm_model_id].present? || params[:status].present? %>
  <p class="text-muted">No test runs match these filters.</p>
<% else %>
  <p class="text-muted">No test runs yet.</p>
<% end %>
