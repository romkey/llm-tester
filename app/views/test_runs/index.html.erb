<h1 class="mb-4">Test Runs</h1>

<% if @test_runs.any? %>
  <div class="table-responsive">
    <table class="table table-hover align-middle">
      <thead>
        <tr>
          <th>When</th>
          <th>Test</th>
          <th>Model</th>
          <th>Server</th>
          <th>Result</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        <% @test_runs.each do |run| %>
          <tr>
            <td><%= l(run.created_at, format: :short) %></td>
            <td><%= run.test_definition.name %></td>
            <td><%= run.llm_model.name %></td>
            <td><%= run.server.name %></td>
            <td><%= test_run_badge(run) %></td>
            <td><%= link_to "Details", test_run_path(run), class: "btn btn-sm btn-outline-secondary" %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <nav class="mt-3"><%== pagy_nav(@pagy) %></nav>
<% else %>
  <p class="text-muted">No test runs yet.</p>
<% end %>
