<%= form_with model: [:settings, llm_model] do |form| %>
  <% if llm_model.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% llm_model.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form_label_with_requirement form, :name, required: true %>
    <%= form.text_field :name, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= form_label_with_requirement form, :server_id, text: "Server", required: true %>
    <%= form.collection_select :server_id, Server.order(:name), :id, :name, { prompt: "Select a server" }, class: "form-select", required: true %>
  </div>

  <div class="mb-3">
    <%= form_label_with_requirement form, :benchmark_latency_mode, text: "Benchmark latency mode", hint: "How llama-benchy measures latency. Use \"none\" or \"api\" for backends that reject empty-content probe requests (HTTP 400)." %>
    <%= form.select :benchmark_latency_mode, LlmModel::BENCHMARK_LATENCY_MODES, {}, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= form_check_label_with_requirement form, :enabled, text: "Enabled", optional: true, hint: "Disabled models are skipped by tests and excluded from health checks." %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", settings_llm_models_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
