<%= form_with model: [:settings, test_definition] do |form| %>
  <% if test_definition.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% test_definition.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= form_label_with_requirement form, :name, required: true %>
    <%= form.text_field :name, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= form_check_label_with_requirement form, :run_on_all_models,
          text: "Run on all models",
          optional: true,
          hint: "When enabled, the model field is not used.",
          check_box_options: {
            data: { test_definition_form_target: "allModels", action: "test-definition-form#toggleModel" }
          } %>
  </div>

  <div class="mb-3" data-test-definition-form-target="modelField">
    <%= form_label_with_requirement form, :llm_model_id, text: "Model", required: true, hint: "Not used when Run on all models is enabled." %>
    <%= form.collection_select :llm_model_id, LlmModel.for_selection(current_id: test_definition.llm_model_id), :id, :label_with_server, { include_blank: "Select a model" }, class: "form-select" %>
  </div>

  <div class="mb-3">
    <%= form_label_with_requirement form, :prompt, required: true %>
    <%= form.text_area :prompt, class: "form-control", rows: 4, required: true %>
  </div>

  <div class="mb-3">
    <%= form_label_with_requirement form, :image, text: "Image", optional: true,
          hint: "Optional. Sent with the prompt for vision-capable models." %>
    <%= form.file_field :image, class: "form-control", accept: "image/png,image/jpeg,image/gif,image/webp" %>
    <% if test_definition.image.attached? %>
      <div class="mt-2">
        <%= image_tag test_definition.image, class: "img-thumbnail", style: "max-height: 120px" %>
        <p class="form-text mb-0"><%= test_definition.image.filename %></p>
        <div class="form-check mt-2">
          <%= check_box_tag "test_definition[remove_image]", "1", false, class: "form-check-input", id: "test_definition_remove_image" %>
          <%= label_tag "test_definition_remove_image", "Remove image", class: "form-check-label" %>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mb-3">
    <%= form_label_with_requirement form, :response_type, required: true %>
    <%= form.select :response_type, TestDefinition::RESPONSE_TYPES, {}, class: "form-select", required: true %>
  </div>

  <div class="mb-3">
    <%= form_label_with_requirement form, :expected_response, text: "Expected Response", optional: true, hint: "Required when response type is Exact." %>
    <%= form.text_area :expected_response, class: "form-control", rows: 3 %>
  </div>

  <div class="mb-3">
    <%= form_label_with_requirement form, :regex_pattern, text: "Regex Pattern", optional: true, hint: "Required when response type is Approximate." %>
    <%= form.text_field :regex_pattern, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= form_label_with_requirement form, :frequency_minutes, text: "Run every (minutes)", required: true %>
    <%= form.number_field :frequency_minutes, class: "form-control", min: 1, required: true %>
  </div>

  <div class="mb-3">
    <%= form_check_label_with_requirement form, :enabled, text: "Enabled", optional: true, hint: "Disabled tests are not run on schedule." %>
  </div>

  <div class="d-flex gap-2">
    <%= form.submit class: "btn btn-primary" %>
    <%= link_to "Cancel", settings_test_definitions_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
