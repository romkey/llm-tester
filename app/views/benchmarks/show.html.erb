<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="mb-0">Benchmark Run</h1>
  <% if @benchmark_run.passed? %>
    <%= tag.span("Passed", class: "badge text-bg-success") %>
  <% else %>
    <%= tag.span("Error", class: "badge text-bg-warning") %>
  <% end %>
</div>

<dl class="row">
  <dt class="col-sm-3">Model</dt>
  <dd class="col-sm-9">
    <%= link_to @benchmark_run.llm_model.name, llm_model_path(@benchmark_run.llm_model) %>
    <% unless @benchmark_run.llm_model.enabled? %>
      <%= tag.span("Disabled", class: "badge text-bg-secondary ms-1") %>
    <% end %>
  </dd>

  <dt class="col-sm-3">Server</dt>
  <dd class="col-sm-9"><%= @benchmark_run.server.name %></dd>

  <dt class="col-sm-3">Started</dt>
  <dd class="col-sm-9"><%= l(@benchmark_run.started_at, format: :long) if @benchmark_run.started_at %></dd>

  <dt class="col-sm-3">Finished</dt>
  <dd class="col-sm-9"><%= l(@benchmark_run.finished_at, format: :long) if @benchmark_run.finished_at %></dd>

  <dt class="col-sm-3">Context depth</dt>
  <dd class="col-sm-9"><%= @benchmark_run.context_depth || "—" %></dd>

  <dt class="col-sm-3">PP throughput</dt>
  <dd class="col-sm-9"><%= format_tokens_per_second(@benchmark_run.prompt_tokens_per_second) %></dd>

  <dt class="col-sm-3">TG throughput</dt>
  <dd class="col-sm-9"><%= format_tokens_per_second(@benchmark_run.generation_tokens_per_second) %></dd>

  <dt class="col-sm-3">Peak TG throughput</dt>
  <dd class="col-sm-9"><%= format_tokens_per_second(@benchmark_run.peak_generation_tokens_per_second) %></dd>

  <dt class="col-sm-3">Time to first token</dt>
  <dd class="col-sm-9"><%= format_ms(@benchmark_run.time_to_first_token_ms) %></dd>

  <dt class="col-sm-3">Est. prompt processing</dt>
  <dd class="col-sm-9"><%= format_ms(@benchmark_run.estimated_prompt_processing_ms) %></dd>
</dl>

<% if @benchmark_run.error_message.present? %>
  <div class="alert alert-warning">
    <strong>Error:</strong> <%= @benchmark_run.error_message %>
  </div>
<% end %>

<div class="card mb-3">
  <div class="card-header">Command</div>
  <div class="card-body">
    <% if @benchmark_run.command.present? %>
      <pre class="mb-0"><%= @benchmark_run.command %></pre>
    <% else %>
      <p class="text-muted mb-0">No command was recorded for this run.</p>
    <% end %>
  </div>
</div>

<div class="card mb-3">
  <div class="card-header">Output</div>
  <div class="card-body">
    <% if @benchmark_run.output.present? %>
      <pre class="mb-0"><%= @benchmark_run.output %></pre>
    <% else %>
      <p class="text-muted mb-0">No output was captured.</p>
    <% end %>
  </div>
</div>

<% if @benchmark_run.raw_report.present? && @benchmark_run.raw_report != "{}" %>
  <details class="card mb-3">
    <summary class="card-header">Raw report (JSON)</summary>
    <div class="card-body">
      <pre class="mb-0"><%= @benchmark_run.raw_report %></pre>
    </div>
  </details>
<% end %>

<div class="mt-3">
  <%= link_to "Back to benchmarks", benchmarks_path, class: "btn btn-outline-secondary" %>
</div>
